{
  "name": "tree-of-pedagogical-ideas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host",
    "dev:api": "tsx watch server/local.ts",
    "build": "tsc --noEmit && vite build",
    "local": "vite build && tsx server/local.ts",
    "test": "tsx scripts/api-test.ts"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "fflate": "^0.8.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  }
}
